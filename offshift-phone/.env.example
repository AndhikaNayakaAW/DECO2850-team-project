# Copy to .env.local. Every value is optional.

# Claude API key for the calendar's voice assistant (console.anthropic.com).
# Without it the assistant uses its scripted voice.
ANTHROPIC_API_KEY=

# Shared storage for the week. Needed on Vercel (serverless hosts don't keep files).
# Vercel's Upstash Redis integration sets these two automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or, from an Upstash database's REST API panel:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Without Redis the week is kept in this file (default .offshift-state.json here).
# OFFSHIFT_STATE_FILE=

# On a public deployment: only people who enter this code can open Offshift.
# The watch's server address then becomes https://<your-site>/w/<code>.
# OFFSHIFT_ACCESS_CODE=
